{
  "name": "@code-compiler/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "images:build": "node scripts/build-images.js"
  },
  "dependencies": {
    "@code-compiler/languages": "workspace:*",
    "@code-compiler/shared": "workspace:*",
    "bullmq": "^6.3.4",
    "dockerode": "^5.0.1",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@code-compiler/problems": "workspace:*",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
