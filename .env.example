# ---- api ----
PORT=8080
NODE_ENV=development

# Comma-separated allowlist. Never "*".
CORS_ORIGINS=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Reverse proxies in front of the API that append to X-Forwarded-For.
# 0 = reached directly; the header is ignored and the socket address is used.
TRUST_PROXY_HOPS=0

# ---- limits ----
MAX_CODE_BYTES=65536
MAX_STDIN_BYTES=65536
MAX_TESTCASES=25
COMPILE_TIMEOUT_MS=60000
EXECUTION_TIMEOUT_MS=5000

# ---- runner ----
# Linux/macOS: /var/run/docker.sock
# Windows:     //./pipe/docker_engine
DOCKER_SOCKET=/var/run/docker.sock
RUNNER_CONCURRENCY=2
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
# Compilation is bounded by COMPILE_TIMEOUT_MS, so it gets a fuller CPU share.
SANDBOX_COMPILE_CPUS=1
SANDBOX_PIDS_LIMIT=64

# ---- web (build time) ----
VITE_API_URL=http://localhost:8080
